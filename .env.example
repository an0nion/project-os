# ── Anthropic (only paid component — ~$5/month) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (free tier: 500MB, 50k rows, 500k edge calls) ───────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJ...anon-public-key...
SUPABASE_SERVICE_KEY=eyJ...service-role-key...   # server-side only

# ── Slack (free — socket mode, DM-only, 3 scopes) ────────────────────────────
# im:history  → read DMs to the bot
# im:write    → open DM conversations
# chat:write  → send messages
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_USER_ID=U...          # your Slack user ID (for direct DM targeting)

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=dev-secret

# ── Web Push — VAPID keys (free, generate: npm run vapid) ────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:you@example.com

# ── Telegram (optional secondary notifications — completely free) ─────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# TELEGRAM_CHAT_ID=your-numeric-chat-id

# ── Playwright on Vercel (optional — needed if you hit many JS-rendered pages) ─
# Uses @sparticuz/chromium — keep disabled until you need it
# ENABLE_PLAYWRIGHT=false
